# BeeGame dashboard development example.
# Copy to .env.local and fill values locally. Do not commit .env.local.

# Local dev ports.
AGENT_WORKFLOW_PORT=62174
VITE_PORT=62173

# Local workspace root for generated projects.
# In hosted SaaS deployments this is a platform/runtime setting, not a normal user setting.
AGENT_WORKFLOW_WORKSPACE_PATH=./Projects

# Persistent secret/session storage. Generate a fresh 32-byte base64 key for
# each environment and keep it outside source control. The session store uses
# AGENT_WORKFLOW_DATA_DIR/auth-sessions.json unless an explicit file path is
# supplied by the application route options.
# BEEGAME_CONFIG_ENCRYPTION_KEY=base64-encoded-32-byte-key
# BEEGAME_HTTPONLY_SESSIONS=0
# VITE_BEEGAME_HTTPONLY_SESSIONS=0

# Outbound policy. Keep HTTP disabled in production and allow only the hosts
# required by the deployment. Ports are restricted to 443/80 unless a host:port
# entry is explicitly allowed.
# BEEGAME_ALLOW_INSECURE_OUTBOUND_HTTP=0
# BEEGAME_OUTBOUND_ALLOWED_HOSTS=api.example.com,storage.example.com

# Upload policy is enforced server-side: max 8 attachments/request, 10 MiB per
# attachment, 32 MiB total attachments, and 48 MiB request body. Accepted types
# and archive/content checks are defined in security/upload-policy.ts.

# HttpOnly session migration: deploy both flags atomically with the same value.
# Leave both disabled for the first deployment, verify the key/store permissions
# in staging, enable both for internal users, then expand gradually. Keep the
# legacy auth path available through the rollback window before removing it.

# Supabase public config. Use anon keys only in frontend and runtime host env.
BEEGAME_SUPABASE_URL=https://your-project.supabase.co
BEEGAME_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Authentication context resilience. A verified identity is refreshed after the
# short fresh window. During a transient Supabase outage, only that same token's
# recently verified identity may be reused for the stale window; an explicit
# 401/403 still invalidates it immediately.
# BEEGAME_AUTH_CONTEXT_CACHE_TTL_MS=15000
# BEEGAME_AUTH_CONTEXT_STALE_TTL_MS=300000
# BEEGAME_AUTH_CONTEXT_RESOLVE_TIMEOUT_MS=3000
# BEEGAME_AUTH_CONTEXT_RETRY_BASE_MS=1000

# Storage bucket names.
BEEGAME_SUPABASE_AVATAR_BUCKET=avatars
BEEGAME_SUPABASE_ASSET_BUCKET=beegame-assets

# Optional static Web game deployment storage. If unset, the runtime host keeps
# deployments in its local workspace volume under /deployments/*.
BEEGAME_DEPLOYMENT_STORAGE_BUCKET=beegame-deployments
BEEGAME_DEPLOYMENT_STORAGE_PREFIX=deployments
# Optional CDN/public bucket root for published games.
# BEEGAME_DEPLOYMENT_STORAGE_PUBLIC_BASE_URL=https://games.example.com

# Project-domain storage cutover. Leave unset (or set to supabase) until the
# R2 foundation and RLS migrations have been applied. These values are
# server-only and must never use a VITE_ prefix.
# BEEGAME_PROJECT_STORAGE_PROVIDER=r2
# BEEGAME_R2_ACCOUNT_ID=your-cloudflare-account-id
# BEEGAME_R2_ACCESS_KEY_ID=your-r2-access-key-id
# BEEGAME_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional environment prefix. The default "beegame" resolves the four bucket
# roles below automatically; explicit role values override individual names.
# BEEGAME_R2_BUCKET_PREFIX=beegame
# Optional browser origins for R2 presigned uploads/downloads.
# BEEGAME_API_CORS_ORIGINS is reused automatically.
# BEEGAME_R2_CORS_ORIGINS=https://studio.example.com
# BEEGAME_R2_PROJECT_BUCKET=beegame-project-private
# BEEGAME_R2_RESOURCE_BUCKET=beegame-resource-private
# BEEGAME_R2_DELIVERY_BUCKET=beegame-delivery
# BEEGAME_R2_LOG_BUCKET=beegame-log-private
# Public Worker or custom-domain root serving the delivery bucket. Presigned
# S3 URLs are not valid on this custom domain.
# BEEGAME_R2_DELIVERY_PUBLIC_BASE_URL=https://games.example.com
# One-time bootstrap credential only. Never expose it to the frontend or keep it
# in the long-running service environment after `bun run r2:bootstrap`.
# CLOUDFLARE_API_TOKEN=your-workers-r2-storage-write-token

# Credit Store billing mode.
# Local clients and normal runtime hosts should use remote and call a trusted
# billing backend. The billing backend itself runs with BEEGAME_BILLING_MODE=server.
BEEGAME_BILLING_MODE=remote
BEEGAME_BILLING_API_BASE_URL=https://billing.example.com

# One-time deployment bootstrap. Use only with `bun run supabase:bootstrap-owner`
# from a trusted admin machine. Do not pass service-role keys to the long-running
# BeeGame frontend build or local-client runtime host.
# BEEGAME_BOOTSTRAP_OWNER_EMAILS=owner@example.com
# BEEGAME_SUPABASE_SERVICE_ROLE_KEY=replace-me

# Smoke test auth. Choose one pair before running `bun run supabase:smoke`.
# BEEGAME_SMOKE_EMAIL=smoke-user@example.com
# BEEGAME_SMOKE_PASSWORD=replace-me
# BEEGAME_SUPABASE_ACCESS_TOKEN=replace-me
# BEEGAME_SUPABASE_USER_ID=replace-me

# Do not put Supabase service-role keys or Stripe secrets in this file for the
# BeeGame frontend or local-client runtime host.
