{
  "name": "bee-game-studio",
  "version": "2.8.4",
  "description": "BeeGameStudio interactive game-building assistant and runtime",
  "type": "module",
  "author": "PhantomLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantomxm2021/BeeGameStudio.git"
  },
  "homepage": "https://github.com/Phantomxm2021/BeeGameStudio#readme",
  "bugs": {
    "url": "https://github.com/Phantomxm2021/BeeGameStudio/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bgs:build": "bun run scripts/build-bgs.ts",
    "bgs:verify": "bun run scripts/verify-bgs-runtime.ts",
    "bgs:check": "bun run scripts/check-bgs.ts",
    "beegame:dev": "bun run scripts/beegame-dev.ts",
    "billing:dev": "npm run --workspace=packages/beegame-billing-server dev",
    "skills:dev": "npm run --workspace=packages/beegame-skills-server dev",
    "dashboard:dev": "bun run scripts/dashboard-dev.ts",
    "dashboard:docker": "sh scripts/beegame-docker.sh up",
    "docker:init": "sh scripts/beegame-docker.sh init",
    "docker:up": "sh scripts/beegame-docker.sh up",
    "docker:down": "sh scripts/beegame-docker.sh down",
    "docker:restart": "sh scripts/beegame-docker.sh restart",
    "docker:logs": "sh scripts/beegame-docker.sh logs",
    "docker:ps": "sh scripts/beegame-docker.sh ps",
    "docker:config": "sh scripts/beegame-docker.sh config",
    "saas:preflight": "bun run scripts/check-beegame-saas-preflight.ts",
    "supabase:bootstrap-owner": "bun run scripts/bootstrap-beegame-owner.ts",
    "supabase:smoke": "bun run scripts/smoke-beegame-supabase.ts",
    "r2:bootstrap": "bun run scripts/bootstrap-beegame-r2.ts",
    "r2:smoke": "bun run scripts/smoke-beegame-r2.ts",
    "r2:reconcile": "bun run scripts/reconcile-beegame-r2-storage.ts",
    "dev": "bun run beegame:dev",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test packages/agent-workflow/src packages/agent-workflow-server/src packages/beegame-*/src scripts",
    "check": "bun run typecheck && bun run test",
    "lint": "biome lint packages scripts",
    "format": "biome format --write packages scripts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fflate": "^0.8.2",
    "sharp": "^0.34.5",
    "undici": "^7.25.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "vite": "^8.0.8",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.1",
    "vitest": "^4.0.18"
  }
}
