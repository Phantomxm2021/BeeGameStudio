          "content_profile",
          "technical_facts",
          "dependencies",
          "error"
        ]
      },
      "indexModulesFields": [
        "requirements",
        "resources"
      ]
    },
    "moduleRelationship": "assets/asset-manifest.json is an index. It points to one requirements module and one resource module per resource; the parser joins those modules into the canonical requirements/resources arrays."
  },
