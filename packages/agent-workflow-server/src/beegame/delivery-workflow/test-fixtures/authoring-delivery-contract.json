      "content_root",
      "generated_asset_root"
    ],
    "moduleLayout": {
      "requirements": {
        "root": "assets/manifest/requirements",
        "extension": ".json",
        "cardinality": "exactly_one",
        "moduleFields": [
          "requirements"
        ]
      },
      "resources": {
        "root": "assets/manifest/resources",
        "extension": ".json",
        "cardinality": "one_per_resource",
        "moduleFields": [
          "id",
          "source",
          "root_path",
          "file_paths",
          "local_file_hashes",
          "provisional",
