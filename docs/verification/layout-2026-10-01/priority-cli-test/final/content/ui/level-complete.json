{
  "schema": "beegame-content.v1",
  "id": "ui-level-complete",
  "kind": "ui-screen",
  "assetRefs": [],
  "data": {
    "rootId": "complete-root",
    "nodes": [
      {
        "id": "complete-root",
        "role": "screen-root",
        "enabled": true,
        "name": "Level Complete Overlay Root",
        "layout": {
          "anchorMin": [0, 0],
          "anchorMax": [1, 1],
          "sizeDelta": [0, 0],
          "position": [0, 0]
        },
        "data": {
          "orientation": "Landscape",
          "referenceResolution": [960, 540],
          "targetViewports": [
            [960, 540],
            [800, 450],
            [1024, 576]
          ],
          "minimumControlSize": [44, 44]
        }
      },
      {
        "id": "complete-scrim",
        "parentId": "complete-root",
        "role": "container",
        "enabled": true,
        "name": "Warm Scrim",
        "layout": {
          "anchorMin": [0, 0],
          "anchorMax": [1, 1],
          "sizeDelta": [0, 0],
          "position": [0, 0],
          "item": {
            "absolute": true
          }
        },
        "style": {
          "background": { "color": "#120A1E", "opacity": 0.72 }
        }
      },
      {
        "id": "complete-panel",
        "parentId": "complete-root",
        "role": "container",
        "enabled": true,
        "name": "Level Complete Panel",
        "layout": {
          "anchor": "middle-center",
          "position": [0, 0],
          "size": [400, 344],
          "container": {
            "direction": "column",
            "gap": 14,
            "padding": [28, 28, 28, 28],
            "justify": "start",
            "align": "stretch"
          }
        },
        "style": {
          "background": { "color": "#1A1226", "opacity": 0.95, "radius": 16 },
          "border": { "width": 2, "color": "#FFC85A", "radius": 16 },
          "cornerRadius": 16
        }
      },
      {
        "id": "complete-title",
        "parentId": "complete-panel",
        "role": "text",
        "enabled": true,
        "text": "关卡完成！",
        "layout": {
          "size": [344, 38]
        },
        "style": {
          "fontSize": 30,
          "color": "#FFC85A",
          "align": "center",
          "fontWeight": 700
        }
      },
      {
        "id": "new-record-badge",
        "parentId": "complete-panel",
        "role": "container",
        "enabled": true,
        "name": "New Record Badge (conditional)",
        "layout": {
          "size": [344, 28],
          "container": {
            "direction": "row",
            "gap": 8,
            "padding": [0, 0, 0, 0],
            "justify": "center",
            "align": "center"
          }
        },
        "data": {
          "visibleWhen": "sessionScore > storedBest",
          "note": "条件性节点：未破纪录时运行时置 enabled:false，后续行上移由实现处理"
        }
      },
      {
        "id": "new-record-icon",
