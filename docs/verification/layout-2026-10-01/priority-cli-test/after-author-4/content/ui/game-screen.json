          "size": [94, 28],
          "container": {
            "direction": "row",
            "gap": 10,
            "padding": [0, 0, 0, 0],
            "justify": "center",
            "align": "center"
          }
        }
      },
      {
        "id": "life-icon-1",
        "parentId": "hud-lives",
        "role": "shape",
        "enabled": true,
        "name": "Life 1",
        "layout": {
          "size": [22, 22]
        },
        "style": {
          "shape": "circle",
          "color": "#EAF6FF"
        }
      },
      {
        "id": "life-icon-2",
        "parentId": "hud-lives",
        "role": "shape",
        "enabled": true,
        "name": "Life 2",
        "layout": {
          "size": [22, 22]
        },
        "style": {
          "shape": "circle",
          "color": "#EAF6FF"
        }
      },
      {
        "id": "life-icon-3",
        "parentId": "hud-lives",
        "role": "shape",
        "enabled": true,
        "name": "Life 3",
        "layout": {
          "size": [22, 22]
        },
        "style": {
          "shape": "circle",
          "color": "#EAF6FF"
        }
      },
      {
        "id": "hud-right",
        "parentId": "hud",
        "role": "container",
        "enabled": true,
        "name": "Best Score + Pause + Mute",
        "layout": {
          "size": [268, 44],
          "container": {
            "direction": "row",
            "gap": 10,
            "padding": [0, 0, 0, 0],
            "justify": "end",
            "align": "center"
          }
        }
      },
      {
        "id": "hud-highscore",
        "parentId": "hud-right",
        "role": "container",
        "enabled": true,
        "name": "Best Score Readout",
        "layout": {
          "size": [132, 28],
          "container": {
            "direction": "row",
            "gap": 6,
            "padding": [0, 0, 0, 0],
            "justify": "start",
            "align": "center"
          }
        }
      },
      {
        "id": "hud-highscore-label",
        "parentId": "hud-highscore",
        "role": "text",
        "enabled": true,
        "text": "最高分",
        "layout": {
          "size": [40, 20]
        },
        "style": {
          "fontSize": 13,
          "color": "#7C89B0",
          "align": "left"
        }
      },
      {
        "id": "hud-highscore-value",
        "parentId": "hud-highscore",
        "role": "text",
        "enabled": true,
        "text": "0000",
        "layout": {
          "size": [80, 24]
        },
        "style": {
