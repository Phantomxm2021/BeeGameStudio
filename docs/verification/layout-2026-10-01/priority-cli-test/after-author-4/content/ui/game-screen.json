        "actions": {
          "click": "game:pause"
        }
      },
      {
        "id": "pause-button-icon",
        "parentId": "pause-button",
        "role": "text",
        "enabled": true,
        "text": "II",
        "layout": {
          "anchor": "middle-center",
          "position": [0, 0],
          "size": [24, 20]
        },
        "style": {
          "fontSize": 15,
          "color": "#9FE9E6",
          "align": "center",
          "fontFamily": "monospace",
          "fontWeight": 700
        }
