{
  "schema": "beegame-content.v1",
  "id": "ui.pause-overlay",
  "kind": "ui-screen",
  "assetRefs": [],
  "data": {
    "rootId": "root",
    "nodes": [
      {
        "id": "root",
        "role": "screen-root",
        "name": "暂停覆盖层根",
        "layout": {
          "size": [1280, 720]
        },
        "data": {
          "orientation": "Landscape",
          "referenceResolution": [1280, 720],
          "targetViewports": [[1280, 720], [1024, 576], [960, 540]],
          "minimumControlSize": [88, 44],
          "compactMaxWidth": 1024
        }
      },
      {
        "id": "dim",
        "parentId": "root",
        "role": "container",
        "name": "半透明压暗遮罩",
        "layout": {
          "anchorMin": [0, 0],
          "anchorMax": [1, 1],
          "sizeDelta": [0, 0]
        },
        "style": {
          "background": { "color": "#060512", "opacity": 0.58 },
          "desaturate": true
        },
        "data": {
          "component": "overlay-dim",
          "note": "冻结压暗，ART_DIRECTION 8"
        }
      },
      {
        "id": "panel",
        "parentId": "dim",
        "role": "container",
        "name": "暂停面板",
        "layout": {
          "anchor": "middle-center",
          "size": [440, 340],
          "container": {
            "direction": "column",
            "gap": 16,
            "padding": [28, 32, 28, 32],
            "align": "center"
          }
        },
        "style": {
          "background": { "color": "#0C0A20", "opacity": 0.94 },
          "border": { "width": 2, "color": "#2DE2FF", "radius": 8 },
          "glow": { "color": "#2DE2FF", "radius": 4, "opacity": 0.25 }
        },
        "data": {
          "component": "neon-panel",
          "layoutRegion": "overlay-page"
        },
        "responsive": {
          "compact": {
            "layout": {
              "size": [400, 340],
              "container": { "direction": "column", "gap": 14, "padding": [24, 24, 24, 24] }
            }
          }
        }
      },
      {
        "id": "pause-title",
        "parentId": "panel",
        "role": "text",
        "text": "已暂停",
        "layout": {
          "size": [376, 40]
        },
        "style": {
          "fontSize": 30,
          "fontWeight": 800,
          "color": "#E8F4FF",
          "align": "center",
          "verticalAlign": "middle",
          "letterSpacing": 8,
          "glow": { "color": "#2DE2FF", "radius": 6, "opacity": 0.45 }
