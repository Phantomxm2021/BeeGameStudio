          "compact": {
            "layout": { "size": [352, 48] }
          }
        }
      },
      {
        "id": "btn-exit",
        "parentId": "pause-button-group",
        "role": "button",
        "text": "返回开始界面",
        "layout": {
          "size": [376, 48]
        },
        "style": {
          "fontSize": 19,
          "fontWeight": 700,
          "color": "#B9C6E8",
          "align": "center",
          "verticalAlign": "middle",
          "letterSpacing": 6,
          "background": { "color": "#101830", "opacity": 0.85 },
          "border": { "width": 2, "color": "#5E72A8", "radius": 8 },
