    "runtimeCapabilities": {
      "title": "Fähigkeiten",
      "subagents": {
        "description": "Erlaubt BeeGame, bei Bedarf unabhängige Teilaufgaben zu delegieren.",
        "note": "Gut für größere Builds und Prüfungen. Einfache Aufgaben bleiben meist bei einem Agenten."
      },
      "items": {
        "autoMemoryEnabled": {
          "label": "runtime.autoMemory",
          "description": "Merkt sich Präferenzen, Projektentscheidungen und nützlichen Kontext.",
          "note": "Verursacht kleine Hintergrundschreibvorgänge und Token-Kosten. Für sensible Projekte abschaltbar.",
          "scope": "newSession"
        },
        "autoDreamEnabled": {
          "label": "runtime.autoDream",
          "description": "Konsolidiert Langzeitgedächtnis und reduziert veraltete Duplikate.",
          "note": "Läuft erst nach Zeit- und Sitzungsschwellen im Hintergrund.",
          "scope": "newSession"
        },
        "skillSearchEnabled": {
          "label": "Skill Search",
          "description": "Findet automatisch passende Skills für die aktuelle Aufgabe.",
          "note": "Fügt leichte Suchkosten hinzu und kann gelegentlich schwache Treffer wählen.",
          "scope": "newSession"
        },
        "treeSitterBashEnabled": {
          "label": "Bash AST parser",
          "description": "Versteht Bash-Struktur und Injection-Risiken mit AST.",
          "note": "Wird über Admin-Einstellungen gesteuert und im nächsten BeeGame-Turn angewendet. Komplexe Befehle werden konservativer.",
          "scope": "restart"
        },
        "webBrowserToolEnabled": {
          "label": "Browser fetch tool",
          "description": "Lässt die Runtime HTML-Text von Webseiten lesen.",
          "note": "Gut für Dokumentation und Seitenprüfungen. Kein vollständiger Browser mit Klick, Eingabe oder JS.",
          "scope": "restart"
        },
        "bashClassifierEnabled": {
          "label": "Bash classifier",
          "description": "Nutzt ein Modell zur Risiko-Klassifizierung von Bash-Befehlen.",
          "note": "Kann wiederholte Freigaben reduzieren, erhöht aber Modellaufrufe. Fehlklassifizierung beeinflusst Berechtigungen.",
          "scope": "restart"
        },
        "mcpSkillsEnabled": {
          "label": "MCP skills",
          "description": "Bindet MCP skill:// Ressourcen in das Skill-System ein.",
          "note": "Qualität hängt von MCP-server-Ressourcen ab und benötigt Feature-Start.",
          "scope": "restart"
        },
        "resourceLibraryEnabled": {
          "label": "Ressourcenbibliothek",
          "description": "Erlaubt Projekt-Agenten, verwaltete Spielressourcen zu suchen und einzubinden.",
          "note": "Gilt für neue Sitzungen; Dienstzugänge bleiben ausschließlich auf dem Server.",
          "scope": "newSession"
        }
      }
