    "legal": {
      "terms": {
        "title": "BeeGame 使用者協議",
        "updatedAt": "2026-06-27",
        "intro": "歡迎使用 BeeGame。本協議說明你在使用 BeeGame 生成、管理和預覽遊戲專案時的基本權利與責任。",
        "sections": [
          {
            "title": "帳號與安全",
            "body": "你需要提供真實可用的信箱和暱稱來建立帳號。請妥善保管登入憑證，不要共享帳號或用於規避系統限制。"
          },
          {
            "title": "生成服務與 Credit",
            "body": "BeeGame 會根據你的輸入呼叫模型、工具和專案執行環境生成遊戲文件、程式碼、資源占位和預覽。生成行為會消耗 credit，實際消耗可能因專案複雜度、模型、工具呼叫和重試次數而變化。"
          },
          {
            "title": "內容與專案歸屬",
            "body": "你保留自己輸入的 idea、上傳資源和專案檔案的權利。你需要確認輸入、上傳和分發的內容不侵犯第三方權利，也不違反適用法律或平台規則。"
          },
          {
            "title": "可用性與風險",
            "body": "BeeGame 會盡力協助你建立可執行的遊戲專案，但生成內容可能包含錯誤、遺漏或不適合商業發布的部分。正式發布前，你應自行審查、測試並確認合規。"
          },
          {
            "title": "禁止行為",
            "body": "不得使用 BeeGame 生成惡意軟體、規避安全策略、侵犯他人權益、違反法律法規或破壞服務穩定性的內容。"
          },
          {
            "title": "變更與終止",
            "body": "BeeGame 可根據產品、安全或合規要求調整功能、計費和使用規則。你可以在個人主頁註銷帳號；註銷後雲端帳號和關聯資料將按系統策略刪除。"
          }
        ]
      },
      "privacy": {
        "title": "BeeGame 隱私條款",
        "updatedAt": "2026-06-27",
        "intro": "本條款說明 BeeGame 如何處理登入、生成遊戲和管理專案過程中涉及的資料。",
        "sections": [
          {
            "title": "我們收集的資料",
            "body": "我們會處理你的帳號資訊、信箱、暱稱、頭像地址、模型配置、專案中繼資料、生成記錄、工具日誌、credit 記錄以及你主動上傳的資源。"
          },
          {
            "title": "資料用途",
            "body": "這些資料用於身分驗證、保存專案、同步配置、執行生成任務、展示歷史記錄、計算 credit、排查錯誤和改進產品體驗。"
          },
          {
            "title": "模型與第三方服務",
            "body": "當你配置第三方 LLM、搜尋、MCP 或託管服務時，相關請求可能會發送到你選擇的服務商。請確認這些服務商的隱私和資料處理規則符合你的需求。"
          },
          {
            "title": "資源與專案檔案",
            "body": "你上傳的素材和生成的專案檔案會用於當前專案構建、預覽和後續修改。請不要上傳你無權使用的素材、敏感身分資訊或密鑰。"
          },
          {
            "title": "資料保留與刪除",
            "body": "你可以在個人主頁註銷帳號。註銷會觸發帳號刪除流程，並按資料庫關聯規則清理雲端帳號資料。部分本地工作目錄、匯出包或備份需要你自行管理。"
          },
          {
            "title": "安全",
            "body": "BeeGame 會透過登入鑑權、權限控制和隔離的專案工作目錄降低風險。你仍應避免在專案或提示詞中寫入未加保護的密鑰、憑證和隱私資訊。"
          }
        ]
      }
    },
