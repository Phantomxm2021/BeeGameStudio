    "legal": {
      "terms": {
        "title": "BeeGame Terms",
        "updatedAt": "2026-06-27",
        "intro": "Welcome to BeeGame. These terms explain your basic rights and responsibilities when generating, managing, and previewing game projects.",
        "sections": [
          {
            "title": "Account and security",
            "body": "You need a valid email and display name to create an account. Keep your credentials secure and do not share accounts or use them to bypass system limits."
          },
          {
            "title": "Generation service and credits",
            "body": "BeeGame may call models, tools, and runtime environments to generate game documents, code, placeholder assets, and previews from your input. Generation consumes credits, and actual usage can vary by project complexity, model, tool calls, and retries."
          },
          {
            "title": "Content and project ownership",
            "body": "You retain rights to your ideas, uploaded assets, and project files. You are responsible for ensuring that your input, uploads, and distribution do not violate third-party rights, laws, or platform rules."
          },
          {
            "title": "Availability and risk",
            "body": "BeeGame aims to help create runnable game projects, but generated content can contain errors, omissions, or material unsuitable for commercial release. Review, test, and validate compliance before publishing."
          },
          {
            "title": "Prohibited use",
            "body": "Do not use BeeGame to generate malware, bypass security controls, infringe rights, violate laws, or damage service stability."
          },
          {
            "title": "Changes and termination",
            "body": "BeeGame may adjust features, billing, and usage rules for product, security, or compliance reasons. You can delete your account from the profile page; cloud account data will be deleted according to system policy."
          }
        ]
      },
      "privacy": {
        "title": "BeeGame Privacy Policy",
        "updatedAt": "2026-06-27",
        "intro": "This notice explains how BeeGame handles data involved in login, game generation, and project management.",
        "sections": [
          {
            "title": "Data we process",
            "body": "We process account information, email, display name, avatar URL, model settings, project metadata, generation records, tool logs, credit records, and assets you upload."
          },
          {
            "title": "How data is used",
            "body": "This data is used for authentication, project storage, configuration sync, generation tasks, history, credit accounting, troubleshooting, and product improvement."
          },
          {
            "title": "Models and third-party services",
            "body": "When third-party LLM, search, MCP, or hosting services are configured, related requests may be sent to the selected providers. Confirm their privacy and data handling rules fit your needs."
          },
          {
            "title": "Assets and project files",
            "body": "Uploaded assets and generated project files are used for the current project build, preview, and future modifications. Do not upload assets you cannot use, sensitive identity data, or secrets."
          },
          {
            "title": "Retention and deletion",
            "body": "You can delete your account from the profile page. Deletion triggers account cleanup according to database relationships. Some local workspaces, exports, or backups may need to be managed separately."
          },
          {
            "title": "Security",
