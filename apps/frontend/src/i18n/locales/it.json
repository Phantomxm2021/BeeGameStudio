          "label": "runtime.autoMemory",
          "description": "Ricorda preferenze, decisioni di progetto e contesto utile.",
          "note": "Aggiunge piccole scritture in background e costo token. Disattivabile per progetti sensibili.",
          "scope": "newSession"
        },
        "autoDreamEnabled": {
          "label": "runtime.autoDream",
          "description": "Consolida la memoria a lungo termine e riduce duplicati obsoleti.",
          "note": "Parte in background solo dopo soglie di tempo e sessioni.",
          "scope": "newSession"
        },
        "skillSearchEnabled": {
          "label": "Skill Search",
          "description": "Trova automaticamente skill rilevanti per il task.",
          "note": "Aggiunge una ricerca leggera e può scegliere a volte un match debole.",
          "scope": "newSession"
        },
        "treeSitterBashEnabled": {
          "label": "Bash AST parser",
          "description": "Comprende struttura Bash e rischi di injection con AST.",
          "note": "Controllato dalle impostazioni admin e applicato al prossimo turno BeeGame. I comandi complessi diventano più prudenti.",
          "scope": "restart"
        },
        "webBrowserToolEnabled": {
          "label": "Browser fetch tool",
          "description": "Permette al runtime di leggere testo HTML dalle pagine web.",
          "note": "Utile per documenti e controlli pagina. Non è un browser completo con click, input o JS.",
