BEEGAME_SUPABASE_URL=https://your-project.supabase.co
BEEGAME_SUPABASE_ANON_KEY=your-supabase-anon-key
BEEGAME_SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional Resource Library R2 cutover. R2 credentials and the Supabase
# service role stay only in this backend service; never expose them to clients.
# BEEGAME_PROJECT_STORAGE_PROVIDER=r2
# BEEGAME_R2_ACCOUNT_ID=your-cloudflare-account-id
# BEEGAME_R2_ACCESS_KEY_ID=your-r2-access-key-id
# BEEGAME_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# BEEGAME_R2_PROJECT_BUCKET=beegame-project-private
# BEEGAME_R2_RESOURCE_BUCKET=beegame-resource-private
# BEEGAME_R2_DELIVERY_BUCKET=beegame-delivery
# BEEGAME_R2_LOG_BUCKET=beegame-log-private

# Optional. Defaults are set in docker-compose.yml.
BEEGAME_RESOURCE_PUBLIC_PORT=62177
