# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS builder

WORKDIR /app

COPY apps/frontend/package.json apps/frontend/package-lock.json ./
ARG NPM_INSTALL_REGISTRY=https://registry.npmmirror.com/
RUN --mount=type=cache,target=/root/.npm \
    npm ci --workspaces=false --no-audit --no-fund \
      --registry=${NPM_INSTALL_REGISTRY} \
      --replace-registry-host=always \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=10000 \
      --fetch-retry-maxtimeout=60000 \
      --fetch-timeout=300000

COPY apps/frontend ./

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL
ARG VITE_WS_BASE_URL
ARG VITE_RESOURCE_API_BASE_URL

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_WS_BASE_URL=$VITE_WS_BASE_URL
ENV VITE_RESOURCE_API_BASE_URL=$VITE_RESOURCE_API_BASE_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
