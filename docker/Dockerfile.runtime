FROM oven/bun:1.3-alpine

RUN apk add --no-cache \
    bash \
    curl \
    findutils \
    git \
    nodejs \
    npm \
    ripgrep

WORKDIR /app

COPY package.json bun.lock bunfig.toml tsconfig.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY src ./src
COPY vendor ./vendor
COPY .beegame /opt/beegame/default-config
COPY docker/runtime-entrypoint.sh /usr/local/bin/beegame-runtime-entrypoint.sh

ENV CLAUDE_CODE_SKIP_CHROME_MCP_SETUP=1

RUN bun install --frozen-lockfile

RUN mkdir -p /srv/beegame/projects /home/bun/.beegame && \
    chmod +x /usr/local/bin/beegame-runtime-entrypoint.sh && \
    chown -R bun:bun /srv/beegame /home/bun/.beegame /app /opt/beegame/default-config

USER bun

ENV NODE_ENV=production
ENV AGENT_WORKFLOW_HOST=0.0.0.0
ENV AGENT_WORKFLOW_PORT=62174
ENV BEEGAME_WORKSPACE_ROOT=/srv/beegame/projects
ENV BEEGAME_CONFIG_DIR=/home/bun/.beegame

EXPOSE 62174

ENTRYPOINT ["beegame-runtime-entrypoint.sh"]
CMD ["bun", "packages/agent-workflow-server/src/index.ts"]
