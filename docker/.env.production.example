VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=https://runtime.your-domain.com
VITE_WS_BASE_URL=wss://runtime.your-domain.com
VITE_RESOURCE_API_BASE_URL=https://resources.your-domain.com

BEEGAME_SUPABASE_URL=https://your-project.supabase.co
BEEGAME_SUPABASE_ANON_KEY=your-supabase-anon-key
BEEGAME_SUPABASE_AVATAR_BUCKET=avatars
BEEGAME_SUPABASE_ASSET_BUCKET=beegame-assets

# Optional. Defaults are set in docker-compose.yml.
BEEGAME_FRONTEND_PORT=18080
# Keep Bun dependency downloads conservative on small Docker hosts. Increase
# only when the build host has sufficient memory and network capacity.
BEEGAME_BUN_INSTALL_NETWORK_CONCURRENCY=2
AGENT_WORKFLOW_PORT=62174
BEEGAME_WORKSPACE_ROOT=/srv/beegame/projects
BEEGAME_PREVIEW_PORT_START=63100
BEEGAME_PREVIEW_PUBLIC_BASE_URL=https://runtime.your-domain.com/previews
BEEGAME_CREDIT_CONTROL_TOKEN=replace-with-the-same-random-value-as-billing
BEEGAME_SKILLS_PUBLIC_PORT=62176

# Shared internal token for beegame-runtime -> beegame-skills service reads.
# scripts/beegame-docker.sh init generates this in docker/.env.production.
BEEGAME_SKILLS_SERVICE_TOKEN=replace-with-a-random-internal-skills-token

# Shared only by beegame-runtime and beegame-resources for read-only catalog
# selection and signed resource integration URLs.
BEEGAME_RESOURCE_SERVICE_TOKEN=replace-with-a-random-internal-resource-token

# Base64-encoded 32-byte key used by the runtime to encrypt stored secrets.
# scripts/beegame-docker.sh init generates this value.
BEEGAME_CONFIG_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Do not put Supabase service-role keys or Stripe secrets in this file.
# Copy docker/.env.billing.example to docker/.env.billing for the dedicated
# beegame-billing service.
