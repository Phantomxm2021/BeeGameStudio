# BeeGame dashboard development example.
# Copy to .env.local and fill values locally. Do not commit .env.local.

# Local dev ports.
AGENT_WORKFLOW_PORT=62174
VITE_PORT=62173

# Local workspace root for generated projects.
# In hosted SaaS deployments this is a platform/runtime setting, not a normal user setting.
AGENT_WORKFLOW_WORKSPACE_PATH=./Projects

# Supabase public config. Use anon keys only in frontend and runtime host env.
BEEGAME_SUPABASE_URL=https://gxhjgqdqxzufxbxfjhmn.supabase.co
BEEGAME_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd4aGpncWRxeHp1ZnhieGZqaG1uIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI1MTA3MDIsImV4cCI6MjA5ODA4NjcwMn0.mf7bG3wm_di1nSzyhXm4l-HI0JzS5V8R9ZL7lZ3nWC8
VITE_SUPABASE_URL=https://gxhjgqdqxzufxbxfjhmn.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd4aGpncWRxeHp1ZnhieGZqaG1uIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI1MTA3MDIsImV4cCI6MjA5ODA4NjcwMn0.mf7bG3wm_di1nSzyhXm4l-HI0JzS5V8R9ZL7lZ3nWC8

# Storage bucket names.
BEEGAME_SUPABASE_AVATAR_BUCKET=avatars
BEEGAME_SUPABASE_ASSET_BUCKET=beegame-assets

# One-time deployment bootstrap. Use only with `bun run supabase:bootstrap-owner`
# from a trusted admin machine. Do not pass service-role keys to the long-running
# BeeGame runtime host or frontend build.
# BEEGAME_BOOTSTRAP_OWNER_EMAILS=owner@example.com
# BEEGAME_SUPABASE_SERVICE_ROLE_KEY=replace-me

# Smoke test auth. Choose one pair before running `bun run supabase:smoke`.
BEEGAME_SMOKE_EMAIL=paris3@163.com
BEEGAME_SMOKE_PASSWORD=Well1996
# BEEGAME_SUPABASE_ACCESS_TOKEN=replace-me
# BEEGAME_SUPABASE_USER_ID=replace-me

# Do not put Supabase service-role keys in this file for the BeeGame runtime host.
BEEGAME_INTAKE_STREAM_DEBUG=1
BEEGAME_INTAKE_STREAM_LOG_PATH=logs/beegame-intake-stream-debug.jsonl